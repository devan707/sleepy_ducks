# Copy to .env.local for local dev (Vite loads .env.local automatically and
# it's gitignored). In Cloudflare, set these as Build/Preview environment
# variables so they're inlined at build time.

# Public PostHog project API key (client-safe "phc_..." key — NOT a secret).
# Leave unset to run with analytics fully disabled (events still log to the
# console in dev / with ?analyticsDebug=1).
VITE_POSTHOG_KEY=

# PostHog ingestion host. Use https://eu.i.posthog.com for an EU-hosted
# project. Defaults to https://us.i.posthog.com when unset.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Override the waitlist signup endpoint. Defaults to the same-origin
# "/api/waitlist", which is served by worker/index.ts. Only needed if the
# API is hosted somewhere other than the game itself.
VITE_WAITLIST_API_URL=
